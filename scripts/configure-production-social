#!/usr/bin/env python3
"""Enable the verified three-brand social collection schedule safely."""

from __future__ import annotations

import os
import tempfile
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
ENV_FILE = ROOT / ".env"
SETTINGS = {
    "VOC_SCHEDULER_ENABLED": "true",
    "VOC_SCHEDULER_FULL_FLOW_ENABLED": "true",
    "TINYFISH_ENABLED": "true",
    "VOC_LIVE_COLLECTION_SOURCE_IDS": (
        "guardian_public_social,hasaki_public_social,watsons_public_social"
    ),
    # Recurring cycles stay deliberately small and overlap for idempotent catch-up.
    "VOC_LIVE_COLLECTION_PAGES_PER_QUERY": "1",
    "VOC_LIVE_COLLECTION_FETCH_LIMIT": "100",
    "VOC_LIVE_COLLECTION_EXTRACTION_LIMIT": "100",
    "VOC_LIVE_COLLECTION_LOOKBACK_DAYS": "2",
    "VOC_LIVE_COLLECTION_REFRESH": "false",
}


def main() -> None:
    if not ENV_FILE.exists():
        raise SystemExit(f"missing production environment file: {ENV_FILE}")

    lines = ENV_FILE.read_text(encoding="utf-8").splitlines()
    found: set[str] = set()
    output: list[str] = []
    for line in lines:
        key = line.split("=", 1)[0].strip() if "=" in line else ""
        if key in SETTINGS:
            if key not in found:
                output.append(f"{key}={SETTINGS[key]}")
                found.add(key)
            continue
        output.append(line)
    for key, value in SETTINGS.items():
        if key not in found:
            output.append(f"{key}={value}")

    mode = ENV_FILE.stat().st_mode & 0o777
    fd, temporary = tempfile.mkstemp(prefix=".env.", dir=ROOT, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write("\n".join(output) + "\n")
        os.chmod(temporary, mode)
        os.replace(temporary, ENV_FILE)
    finally:
        Path(temporary).unlink(missing_ok=True)


if __name__ == "__main__":
    main()
