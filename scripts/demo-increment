#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT_DIR}"

if [[ -x .venv/bin/python ]]; then
  exec .venv/bin/python -m guardian_voc demo-increment --api "${VOC_API_URL:-http://127.0.0.1:8000}"
fi

exec python3 -m guardian_voc demo-increment --api "${VOC_API_URL:-http://127.0.0.1:8000}"

