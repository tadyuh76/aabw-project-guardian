VOC_DB_PATH=data/guardian_voc.duckdb
VOC_DATA_DIR=data
VOC_INBOX_DIR=data/inbox
GUARDIAN_PORT=8000
VOC_DEMO_MODE=false
# VOC_DEMO_AS_OF is used only by the deterministic demo script.
VOC_BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
VOC_ALLOW_INFERRED_DATES=false
VOC_WRITE_API_ENABLED=true
VOC_ADMIN_TOKEN=
VOC_ADMIN_TOKEN_FILE=
VOC_CURRENT_WINDOW_DAYS=7
VOC_BASELINE_WINDOW_DAYS=28
VOC_ALERT_MIN_SUPPORT=8
VOC_ALERT_MIN_EXCESS=5
VOC_ALERT_MIN_GROWTH=1.8
VOC_ALERT_MIN_RATE_DELTA=0.05
VOC_CLASSIFIER_MIN_CONFIDENCE=0.70
VOC_COMPETITOR_MIN_SAMPLE=10
VOC_DEFAULT_LOCALE=en
VOC_CORS_ORIGINS=http://localhost:5173
VOC_LOG_LEVEL=INFO
VOC_SCHEDULER_ENABLED=false
VOC_SCHEDULER_CRAWL_ENABLED=false
VOC_SCHEDULER_FULL_FLOW_ENABLED=false
VOC_SCHEDULER_INTERVAL_SECONDS=1800
VOC_SCHEDULER_INITIAL_DELAY_SECONDS=15
VOC_SCHEDULER_MAX_BACKOFF_SECONDS=14400
VOC_SCHEDULER_SHUTDOWN_TIMEOUT_SECONDS=180
VOC_COLLECTOR_FILES=
# Only point this at the strict, PII-redacted analysis-ready JSONL export.
VOC_VERIFIED_FEEDBACK_FILES=
VOC_COLLECTOR_CHECKPOINT_PATH=
# Off by default. Live deployment enables this only with a mounted TinyFish key.
VOC_COLLECTOR_ENRICHMENT_ENABLED=false
VOC_COLLECTOR_ENRICHMENT_MAX_ROWS=25
VOC_COLLECTOR_ENRICHMENT_CONCURRENCY=3
VOC_LIVE_COLLECTION_SOURCE_IDS=guardian_public_social,hasaki_public_social,watsons_public_social
VOC_LIVE_COLLECTION_PAGES_PER_QUERY=1
VOC_LIVE_COLLECTION_FETCH_LIMIT=25
VOC_LIVE_COLLECTION_EXTRACTION_LIMIT=25
VOC_LIVE_COLLECTION_LOOKBACK_DAYS=2
VOC_LIVE_COLLECTION_REFRESH=false

AI_PROVIDER=openai_compatible
# Required by scripts/prod-up for agentic column detection and classification.
OPENAI_API_KEY=
AI_API_KEY_FILE=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.4-mini
AI_BATCH_SIZE=20
AI_REQUEST_TIMEOUT_SECONDS=30

SERP_API_KEY=
SERP_API_KEY_FILE=
SERP_API_BASE_URL=https://serpapi.com
CRAWLER_KEYWORDS=guardian vietnam,hasaki vietnam,watsons vietnam
CRAWLER_PLATFORMS=facebook,tiktok,youtube,reddit,threads
CRAWLER_LOOKBACK_DAYS=1

TINYFISH_ENABLED=false
# Optional: required only when scheduled TinyFish collection is enabled.
TINYFISH_API_KEY=
TINYFISH_API_KEY_FILE=
TINYFISH_SEARCH_BASE_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_BASE_URL=https://api.fetch.tinyfish.ai
TINYFISH_TIMEOUT_SECONDS=150
TINYFISH_USEFUL_TEXT_CHARS=80
TINYFISH_LOCATION=VN
TINYFISH_LANGUAGE=vi

# Authorized Guardian seller API ingestion. Leave blank unless the matching
# Guardian-owned seller account has granted access; never commit real values.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_ACCESS_TOKEN=
SHOPEE_SHOP_ID=
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_ACCESS_TOKEN=
